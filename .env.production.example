# Keycloak - Production (VPS)
# cp .env.production.example .env
# Değerleri doldur!

# PostgreSQL - güçlü şifre kullan
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=GÜÇLÜ_ŞİFRE_BURAYA

# Keycloak Admin - güçlü şifre kullan
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=GÜÇLÜ_KEYCLOAK_ŞİFRE

# Prod domain (Cloudflare -> auth.iyihislerapp.com -> sunucu)
KEYCLOAK_HOSTNAME=https://auth.iyihislerapp.com

# JWT doğrulaması için - Keycloak token issuer ile eşleşmeli (KEYCLOAK_HOSTNAME/realms/psikohekim)
APP_JWT_ISSUER_URI=https://auth.iyihislerapp.com/realms/psikohekim

# admin-cli client secret: master realm → Clients → admin-cli → Client authentication ON → Credentials
# Secret yoksa: Settings → Client authentication ON → Save → Credentials sekmesi görünür
APP_KEYCLOAK_ADMIN_ADMINCLIENTSECRET=48nB8sqCaphu6DoHi2zWwqopwZ281Ql1
